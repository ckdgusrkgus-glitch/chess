<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    tools:context="chess.ui.MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textColor="@color/text_primary"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="56dp"
        android:text="♔ ♕ ♖ ♗ ♘ ♙"
        android:textColor="@color/text_secondary"
        android:textSize="30sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/twoPlayerButton"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="@string/two_player"
        android:textSize="18sp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/accent_green" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/vsAiButton"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/vs_ai"
        android:textSize="18sp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/accent_green" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exitButton"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/exit"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/panel_bg" />

</LinearLayout>
